# =============================================================================
# ZeruX OS — Build System
# File: Makefile
# =============================================================================
#
# PREREQUISITES (install in WSL / Linux):
#
#   1. NASM — assembler for the bootloader
#        sudo apt install nasm
#
#   2. i686-elf-gcc — cross-compiler targeting 32-bit x86 bare metal
#      (builds a GCC that produces ELF binaries with no Linux assumptions)
#        sudo apt install gcc-multilib
#      OR build from source (recommended for full control):
#        Scripts at https://github.com/lordmilko/i686-elf-tools
#
#   3. i686-elf-ld — cross-linker (usually bundled with the cross-compiler)
#
#   4. QEMU — for running the OS
#        sudo apt install qemu-system-x86
#
#   5. dd, objcopy — from GNU coreutils / binutils (pre-installed on Linux)
#
# HOW THE BUILD WORKS:
# ─────────────────────
#   Step 1: NASM assemble boot.asm → build/boot.bin  (flat 512-byte MBR binary)
#   Step 2: GCC compile  kernel.c  → build/kernel.o   (ELF object file)
#   Step 3: ld link  kernel.o      → build/kernel.elf  (ELF binary at 0x100000)
#   Step 4: objcopy strip ELF headers → build/kernel.bin (raw flat binary)
#   Step 5: dd concatenate boot.bin + kernel.bin → zerux.img
#           The image layout on "disk":
#             Byte    0–511  : MBR / bootloader (boot.bin)
#             Byte  512+     : Kernel (kernel.bin)  ← sectors 2+ in CHS
#
# DISK IMAGE LAYOUT:
#   Sector 1 (512B) : boot.bin     — MBR, loaded by BIOS at 0x7C00
#   Sectors 2–11    : kernel.bin   — 10 sectors = 5120 bytes (10 × 512)
#
# =============================================================================

# ── Toolchain Auto-detection ──────────────────────────────────────────────────
#
# If i686-elf-gcc cross-compiler is installed, use it (recommended standard).
# Otherwise, fall back to native GCC with -m32 flag.
#
HAS_CROSS := $(shell command -v i686-elf-gcc 2>/dev/null)

ifneq ($(HAS_CROSS),)
    CC      := i686-elf-gcc
    LD      := i686-elf-ld
    OBJCOPY := i686-elf-objcopy
else
    CC      := gcc
    LD      := ld
    OBJCOPY := objcopy
endif

AS          := nasm

# ── Flags ────────────────────────────────────────────────────────────────────
#
# Compiler flags — every flag explained:
#   -ffreestanding   : Tell GCC we have no OS / stdlib. Disables assumptions
#                      about the C runtime environment (no main(), no atexit…)
#   -O2              : Optimize for speed (safe; doesn't break bare-metal code)
#   -Wall -Wextra    : Enable all warnings — good practice
#   -m32             : Target 32-bit x86 (i386) instruction set
#   -nostdlib        : Don't link with any standard library
#   -fno-stack-protector : Disable stack canaries (no __stack_chk_fail in kernel)
#   -fno-builtin     : Don't replace standard calls with compiler built-ins
#                      (prevents GCC from inserting calls to memcpy etc.)
#   -I$(INCLUDE_DIR) : Look for header files in our include/ directory
#
CFLAGS  := -ffreestanding -O2 -Wall -Wextra -m32 -nostdlib \
           -fno-stack-protector -fno-builtin \
           -fno-pic -fno-pie \
           -Iinclude -Ikernel/include
#
# -m32             : 32-bit x86 code (requires gcc-multilib)
# -fno-pic/pie     : Sabit adres — kernel 0x100000'de çalışır
# -Iinclude        : root include/ (vga.h)
# -Ikernel/include : kernel/include/ (ports.h, serial.h, ...)

# Linker flags:
#   -T $(LD_SCRIPT)  : Use our custom linker script
#   -m elf_i386      : Output ELF for 32-bit x86
#   --oformat binary : (used via objcopy instead)
#   --no-undefined   : Error if any symbol is referenced but not defined
LDFLAGS := -T kernel/linker.ld -m elf_i386 --no-undefined

# Assembler flags:
#   -f bin           : Flat binary output (no ELF/COFF headers)
ASFLAGS := -f bin

# ── Directory layout ──────────────────────────────────────────────────────────
BOOT_DIR    := bootloader
KERNEL_DIR  := kernel
INCLUDE_DIR := include
BUILD_DIR   := build

# ── Target files ─────────────────────────────────────────────────────────────
BOOT_SRC    := $(BOOT_DIR)/boot.asm
BOOT2_SRC   := $(BOOT_DIR)/boot2.asm
KERNEL_SRC  := $(KERNEL_DIR)/kernel.c
LINKER_LD   := $(KERNEL_DIR)/linker.ld

BOOT_BIN    := $(BUILD_DIR)/boot.bin
BOOT2_BIN   := $(BUILD_DIR)/boot2.bin
KERNEL_OBJ  := $(BUILD_DIR)/kernel.o
SERIAL_OBJ  := $(BUILD_DIR)/serial.o     # Adim 1.1: COM1 UART driver
ARCH_OBJ    := $(BUILD_DIR)/arch_ports.o  # Adim 1.1: I/O port _p varyantlari
IDT_OBJ     := $(BUILD_DIR)/idt.o         # Adim 1.2: IDT setup & gate loader
ISR_OBJ     := $(BUILD_DIR)/isr.o         # Adim 1.2: CPU Exception C Handler & Panic
ISR_ASM_OBJ := $(BUILD_DIR)/isr_asm.o     # Adim 1.2: Low-level ISR assembly stubs
TESTS_OBJ   := $(BUILD_DIR)/debug_tests.o # Adim 1.3: Debug Exception Test Suite
PIC_OBJ     := $(BUILD_DIR)/pic.o         # Adim 1.4: 8259A PIC Driver
PCI_OBJ     := $(BUILD_DIR)/pci.o
RTC_OBJ     := $(BUILD_DIR)/rtc.o
IRQ_OBJ     := $(BUILD_DIR)/irq.o         # Adim 1.4: IRQ Dispatcher & Registry
IRQ_ASM_OBJ := $(BUILD_DIR)/irq_asm.o     # Adim 1.4: Assembly IRQ 0..15 Stubs
TIMER_OBJ   := $(BUILD_DIR)/timer.o       # Adim 1.5: PIT Channel 0 100Hz Driver
KEYBOARD_OBJ:= $(BUILD_DIR)/keyboard.o    # Adim 1.5: PS/2 Keyboard IRQ1 Driver
BOOT_INFO_OBJ:= $(BUILD_DIR)/boot_info.o  # Adim 2.0: BIOS E820 Memory Map Parser
PMM_OBJ     := $(BUILD_DIR)/pmm.o        # Adim 2.1: Physical Memory Manager (Bitmap Allocator)
VMM_OBJ     := $(BUILD_DIR)/vmm.o        # Adim 2.2: Virtual Memory Manager (32-bit Paging)
KHEAP_OBJ   := $(BUILD_DIR)/kheap.o      # Adim 2.3: Kernel Heap Allocator (kmalloc/kfree)
GDT_OBJ     := $(BUILD_DIR)/gdt.o        # Adim 3.0: Dynamic GDT Setup (6 Descriptors)
GDT_ASM_OBJ := $(BUILD_DIR)/gdt_asm.o    # Adim 3.0: Assembly LGDT, Segment reload, LTR stub
TSS_OBJ     := $(BUILD_DIR)/tss.o        # Adim 3.0: Task State Segment (TSS) Driver
TASK_OBJ    := $(BUILD_DIR)/task.o       # Adim 3.1: Process Control Block (PCB / task_t) Manager
SCHEDULER_OBJ := $(BUILD_DIR)/scheduler.o# Adim 3.2: Preemptive Round-Robin Scheduler
SWITCH_ASM_OBJ := $(BUILD_DIR)/switch_asm.o # Adim 3.2: Assembly Context Switch Stub (switch_to)
USERMODE_OBJ   := $(BUILD_DIR)/usermode.o  # Adim 3.3: User Mode (Ring 3) Transition Driver
USERMODE_ASM_OBJ := $(BUILD_DIR)/usermode_asm.o # Adim 3.3: Assembly IRET Ring 3 Switch Stub
SYSCALL_OBJ    := $(BUILD_DIR)/syscall.o   # Adim 3.4: System Call Engine (int 0x80) C Dispatcher
SYSCALL_ASM_OBJ:= $(BUILD_DIR)/syscall_asm.o# Adim 3.4: Low-level int 0x80 Assembly Stub
USERMODE_APP_OBJ := $(BUILD_DIR)/usermode_app.o # Adim 3.4: Ring 3 User Mode Demo Application
ATA_OBJ         := $(BUILD_DIR)/ata.o          # Adim 4.1: Primary ATA/IDE Hard Disk Controller Driver
VFS_OBJ         := $(BUILD_DIR)/vfs.o          # Adim 4.2: Virtual File System (VFS Core Abstraction)
DEVFS_OBJ       := $(BUILD_DIR)/devfs.o        # Adim 4.3: Virtual Device File System (/dev)
PROCFS_OBJ      := $(BUILD_DIR)/procfs.o       # Adim 4.4: Process File System (/proc)
FAT32_OBJ       := $(BUILD_DIR)/fat32.o        # Adim 4.5: FAT32 Interoperable File System Driver
ROOTFS_OBJ      := $(BUILD_DIR)/rootfs.o       # Adim 4.6: Root File System (/)
USERFS_OBJ      := $(BUILD_DIR)/userfs.o       # Adim 4.6b: RAM Writable User Filesystem (/user)
PIPE_OBJ        := $(BUILD_DIR)/pipe.o         # Adim 4.7: Pipe IPC Driver
SHELL_OBJ       := $(BUILD_DIR)/shell.o        # Adim 4.7: Interactive VFS Shell CLI Interface
GUI_OBJ         := $(BUILD_DIR)/gui.o          # GUI Desktop Environment
WINDOW_OBJ      := $(BUILD_DIR)/window.o        # Window Manager: window_t data model
COMPOSITOR_OBJ  := $(BUILD_DIR)/compositor.o     # Window Manager: Compositor paint layer
VBE_OBJ         := $(BUILD_DIR)/vbe.o          # Adim 5.3: VBE Linear Framebuffer Driver
VBE_TERM_OBJ    := $(BUILD_DIR)/vbe_terminal.o # Adim 5.3b: VBE Scrollable Terminal Driver
SURFACE_OBJ     := $(BUILD_DIR)/surface.o      # Graphics Stage 1: Surface Abstraction
DIRTY_RECT_OBJ  := $(BUILD_DIR)/dirty_rect.o    # Graphics Stage 1: Dirty Rectangle Manager
FRAMEBUFFER_OBJ := $(BUILD_DIR)/framebuffer.o   # Graphics Stage 1: Framebuffer Manager
GFX2D_OBJ       := $(BUILD_DIR)/gfx2d.o         # Graphics Stage 1: 2D Graphics Library
MOUSE_OBJ       := $(BUILD_DIR)/mouse.o        # Adim 5.4: PS/2 Mouse Driver
ELF_OBJ         := $(BUILD_DIR)/elf.o          # Adim 5.5: ELF32 Parser and Loader
RTL8139_OBJ     := $(BUILD_DIR)/rtl8139.o      # Adim 6.1: RTL8139 Network Driver
RTL8168_OBJ     := $(BUILD_DIR)/rtl8168.o      # Adim 6.1b: RTL8168 Network Driver
NET_OBJ         := $(BUILD_DIR)/net.o          # Adim 6.2: Network Stack (Ethernet/IPv4/ICMP/ARP)
UDP_OBJ         := $(BUILD_DIR)/udp.o          # Adim 6.6: User Datagram Protocol (UDP)
DHCP_OBJ        := $(BUILD_DIR)/dhcp.o         # Adim 6.6b: DHCP Client
DNS_OBJ         := $(BUILD_DIR)/dns.o          # Adim 6.9: DNS Client
TCP_OBJ         := $(BUILD_DIR)/tcp.o          # Adim 6.10: TCP Layer
TCP_TIMER_OBJ   := $(BUILD_DIR)/tcp_timer.o
WAIT_OBJ        := $(BUILD_DIR)/wait.o
TEST_TCP_OBJ    := $(BUILD_DIR)/test_tcp.o
SOCKET_OBJ      := $(BUILD_DIR)/socket.o       # Socket API Wrapper
HTTP_PARSER_OBJ := $(BUILD_DIR)/http_parser.o  # HTTP Parser

# =============================================================================
# RUN  — Launch ZeruX in QEMU
# =============================================================================
#
# qemu-system-i386 flags:
#   -drive format=raw,file=zerux.img
#     → Attach our flat binary as the first drive (equivalent to a USB/HDD)
#     → format=raw : No disk image header (qcow2, vmdk, etc.) — raw bytes
#   -m 32M
#     → Allocate 32 MB of RAM for the VM (plenty for our 5 KB kernel)
#   -no-reboot
#     → Don't automatically reboot on triple fault — easier to see crashes
#   -no-shutdown
#     → Keep QEMU window open after halt — lets us see the VGA output
#
run: $(DISK_IMAGE)
	@echo "[RUN] Launching ZeruX in QEMU..."
	@echo "      (Press Ctrl+Alt to release mouse, Ctrl+A X to quit)"
	qemu-system-i386 \
		-drive format=raw,file=$(DISK_IMAGE) \
		-m 64M \
		-no-reboot \
		-no-shutdown \
		-device VGA,vgamem_mb=16 \
		-netdev user,id=u1 -device rtl8139,netdev=u1

# VBE + Serial combined (recommended for Faz 5 testing)
run-vbe: $(DISK_IMAGE)
	@echo "[RUN] ZeruX VBE framebuffer mode + Serial log"
	qemu-system-i386 \
		-drive format=raw,file=$(DISK_IMAGE) \
		-m 64M \
		-no-reboot \
		-no-shutdown \
		-device VGA,vgamem_mb=16 \
		-netdev user,id=u1 -device rtl8139,netdev=u1 \
		-serial stdio

# =============================================================================
# DEBUG-SERIAL — Adim 1.1 Test: serial ciktiyi terminale yonlendir
# =============================================================================
# -serial stdio  : COM1 seri portu bu terminale baglaniyor.
#                  Kernel'in serial_printf() ciktisi burada gorunur.
# -display none  : VGA penceresi acilmaz (sadece seri port test edilir)
#                  Sadece seri portu test ederken kullanisli.
# -serial stdio + VGA ayni anda test etmek icin:
#   make run-serial   → hem VGA penceresi hem terminal serial
#
debug-serial: $(DISK_IMAGE)
	@echo "[SER] ZeruX seri port ciktisi bu terminalde gorunecek"
	@echo "      Cikmak icin: Ctrl+A sonra X"
	qemu-system-i386 \
		-drive format=raw,file=$(DISK_IMAGE) \
		-m 32M \
		-no-reboot \
		-no-shutdown \
		-serial stdio \
		-display none

# Hem VGA penceresi hem terminal serial ciktisi
run-serial: $(DISK_IMAGE)
	@echo "[RUN] ZeruX basliyor: VGA + Serial (bu terminalde)"
	qemu-system-i386 \
		-drive format=raw,file=$(DISK_IMAGE) \
		-m 32M \
		-no-reboot \
		-no-shutdown \
		-serial stdio

# =============================================================================
# DEBUG — Run with GDB server for step-through debugging
# =============================================================================
#
# QEMU listens for a GDB connection on localhost:1234.
# After running `make debug`, open another terminal and run:
#
#   gdb
#   (gdb) target remote :1234
#   (gdb) set architecture i8086      # for real mode
#   (gdb) break *0x7C00
#   (gdb) continue
#
debug: $(DISK_IMAGE)
	@echo "[DBG] Starting QEMU with GDB server on :1234"
	@echo "      Connect with: gdb → target remote :1234"
	qemu-system-i386 \
		-drive format=raw,file=$(DISK_IMAGE) \
		-m 32M \
		-no-reboot \
		-no-shutdown \
		-s -S

# =============================================================================
# INFO — Print sizes of all build artifacts
# =============================================================================
info: $(DISK_IMAGE)
	@echo ""
	@echo "  Build artifact sizes:"
	@echo "  ─────────────────────────────────────────"
	@wc -c $(BOOT_BIN)   | awk '{printf "  Boot binary  : %6d bytes\n", $$1}'
	@wc -c $(KERNEL_BIN) | awk '{printf "  Kernel binary: %6d bytes\n", $$1}'
	@wc -c $(DISK_IMAGE) | awk '{printf "  Disk image   : %6d bytes (%d sectors)\n", $$1, $$1/512}'
	@echo ""

# =============================================================================
# CLEAN — Remove all build artifacts
# =============================================================================
clean:
	@echo "[RM]  Cleaning build directory..."
	rm -rf $(BUILD_DIR) $(DISK_IMAGE)
	@echo "      Done."
$(SURFACE_OBJ): kernel/drivers/surface.c kernel/include/surface.h kernel/include/kheap.h | $(BUILD_DIR)
	@echo "[CC]  $< --> $@"
	$(CC) $(CFLAGS) -c $< -o $@

$(DIRTY_RECT_OBJ): kernel/drivers/dirty_rect.c kernel/include/dirty_rect.h | $(BUILD_DIR)
	@echo "[CC]  $< --> $@"
	$(CC) $(CFLAGS) -c $< -o $@

$(FRAMEBUFFER_OBJ): kernel/drivers/framebuffer.c kernel/include/framebuffer.h kernel/include/surface.h kernel/include/dirty_rect.h kernel/include/vbe.h | $(BUILD_DIR)
	@echo "[CC]  $< --> $@"
	$(CC) $(CFLAGS) -c $< -o $@

$(GFX2D_OBJ): kernel/drivers/gfx2d.c kernel/include/gfx2d.h kernel/include/framebuffer.h kernel/include/dirty_rect.h kernel/drivers/font8x16.h | $(BUILD_DIR)
	@echo "[CC]  $< --> $@"
	$(CC) $(CFLAGS) -c $< -o $@
$(WINDOW_OBJ): kernel/gui/window.c kernel/include/window.h kernel/include/surface.h kernel/include/gfx2d.h kernel/include/mouse.h kernel/include/serial.h | $(BUILD_DIR)
	@echo "[CC]  $< --> $@"
	$(CC) $(CFLAGS) -c $< -o $@

$(COMPOSITOR_OBJ): kernel/gui/compositor.c kernel/include/compositor.h kernel/include/window.h kernel/include/framebuffer.h kernel/include/gfx2d.h | $(BUILD_DIR)
	@echo "[CC]  $< --> $@"
	$(CC) $(CFLAGS) -c $< -o $@
